# Все параметры имеют рабочие значения по умолчанию: сервис поднимается
# командой `docker compose up -d` без единой настройки и без внешних ключей.
# Файл нужен только чтобы что-то переопределить.

# Подключение к базе (в compose подставляется автоматически)
FXWATCH_DB_DSN=postgresql+psycopg://fxwatch:fxwatch@localhost:5432/fxwatch

# Часовой пояс расписания. ЦБ публикует курсы по московскому времени.
FXWATCH_TZ=Europe/Moscow

# Окно перезапроса в днях: догон пропущенного, детекция ревизий
# и граница, после которой период считается закрытым.
FXWATCH_SWEEP_DAYS=14

# Сколько дней истории залить при первом запуске на пустой базе.
FXWATCH_BOOTSTRAP_DAYS=90

# Пороги проверок качества.
# Ожидаемое число рядов задаётся у самого источника в коде
# (Source.min_expected_series), потому что у ЦБ это около 54 валют,
# а у источника для сверки ровно три, и общий порог был бы неверен.
FXWATCH_JUMP_WARN_PCT=10
FXWATCH_JUMP_ERROR_PCT=30
FXWATCH_STALE_BUSINESS_DAYS=3
# Свежесть меряется двумя линейками: часы без успешного обращения к источнику
# и календарные дни без единой новой даты. Вторая линейка нужна потому, что ЦБ
# не устанавливает курс на воскресенье и понедельник: штатная тишина - 72 часа,
# новогодняя - до 11 дней.
FXWATCH_FRESHNESS_HOURS=36
FXWATCH_FRESHNESS_MAX_GAP_DAYS=12
FXWATCH_CROSS_SOURCE_WARN_PCT=5
FXWATCH_REVISION_EPSILON_PCT=0.05

# Хранение сырых ответов, дней. Наблюдения и журнал прогонов не удаляются никогда.
FXWATCH_RAW_RETENTION_DAYS=30

# Необязательный вебхук для алертов. Если не задан, алерты всё равно
# пишутся в базу и видны в отчёте и на дашборде.
FXWATCH_ALERT_WEBHOOK=

# URL внешнего наблюдателя (dead man's switch): healthchecks.io, Better Stack
# или любой аналог. Сервис дёргает его после каждого успешного цикла, и если
# пинги прекратятся, тревогу поднимет внешняя система - собственный журнал
# о смерти собственного процесса рассказать не может.
FXWATCH_HEARTBEAT_URL=

# Версия кода, попадает в каждый прогон. В CI подставляется git sha.
FXWATCH_CODE_VERSION=dev
