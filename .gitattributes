# В образе всё выполняется под Linux, поэтому в репозитории всегда LF.
* text=auto eol=lf

# Фикстуры ответов ЦБ лежат в windows-1251, как отдаёт настоящий источник.
# Любая нормализация окончаний строк здесь означала бы, что тест проверяет
# не тот формат, который приходит в реальности.
tests/fixtures/*.xml -text -diff
